# Syntech Smart Farm — nginx (prod)
# envsubst แทน ${BACKEND_ORIGIN} ฯลฯ ตอน container start (ตัวแปร nginx เช่น $uri/$host ไม่ถูกแตะ)
#
# ⚠️⚠️ ชุด security header ถูก **เขียนซ้ำในทุก location block โดยตั้งใจ** ⚠️⚠️
#
# nginx สืบทอด `add_header` ลง location **เฉพาะเมื่อ location นั้นไม่มี `add_header` ของตัวเอง**
# มีแม้แต่ตัวเดียว (เช่น Cache-Control) = ทิ้งของชั้น server ทั้งหมด และ `always` ไม่ช่วย (คนละเรื่อง)
#
# ของเดิมประกาศไว้ชั้น server ชั้นเดียว ผลคือ `/index.html` (ซึ่ง SPA fallback วิ่งเข้าทุกครั้ง
# ผ่าน internal redirect ของ try_files) **ไม่มี security header เลยสักตัว** ทุกการโหลดหน้า
# → เว็บถูกฝังใน iframe ของใครก็ได้ = clickjacking บนปุ่มสั่งพัดลม/ปั๊มจริง
#
# nginx ไม่มี macro และไฟล์ snippet แยกใช้ envsubst ไม่ได้ (entrypoint ประมวลผลเฉพาะ
# /etc/nginx/templates/*.template แล้วเขียนลง conf.d) จึงต้องยอมซ้ำ — **ห้ามรวบให้เหลือที่เดียว**

# ค่า env ต้องผ่านตัวแปร nginx ก่อนถึงจะเอาไปเทียบใน `if` ได้ (envsubst แทนค่าให้ตอน start)
map $host $farm_user { default "${FARM_USER}"; }

server {
  listen 80;
  server_name _;
  root /usr/share/nginx/html;
  index index.html;

  # บีบอัดไฟล์ข้อความ
  gzip on;
  gzip_comp_level 6;
  gzip_min_length 1024;
  gzip_types text/plain text/css application/javascript application/json image/svg+xml;

  # ── reverse-proxy คำสั่งจริง → backend (same-origin เลี่ยง CORS) ──
  # /hs-proxy/api/v1/... → ${BACKEND_ORIGIN}/api/v1/... (trailing slash ตัด prefix ออก)
  # apiBaseUrl() ฝั่งเว็บคืน `/hs-proxy/api/v1` · WebSocket ต่อ backend ตรง ไม่ผ่านที่นี่
  location /hs-proxy/ {
    proxy_pass ${BACKEND_ORIGIN}/;
    proxy_http_version 1.1;
    proxy_ssl_server_name on;          # SNI สำหรับ backend HTTPS
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    # ส่ง Authorization/Content-Type ต่อให้ upstream อัตโนมัติ (ไม่ล้าง) · ไม่ cache ผล

    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Content-Security-Policy "${CSP}" always;
  }

  # ── reverse-proxy ผู้ช่วย AI → เซิร์ฟเวอร์ llama.cpp ในวง LAN ──
  # /ai-proxy/v1/chat/completions → ${AI_ORIGIN}/v1/chat/completions
  #
  # 🔴 **จำเป็นต้อง proxy ไม่ใช่แค่ความสะดวก** — หน้าเว็บอยู่หลัง TLS แต่เครื่อง AI เป็น http://
  # เบราว์เซอร์บล็อกคำขอ HTTP ที่ออกจากหน้า HTTPS (mixed content) ยิงตรงไม่มีทางผ่าน
  # และ CSP ตั้ง `connect-src 'self'` ไว้ ซึ่ง path บน origin เดียวกันผ่านอยู่แล้ว
  #
  # ถ้าวันหลังเซิร์ฟเวอร์ AI ต้องใช้คีย์ **ให้ใส่ตรงนี้** (`proxy_set_header Authorization ...`)
  # ห้ามเอาไปไว้ใน VITE_* เด็ดขาด — ค่าพวกนั้นถูกฝังลงไฟล์ JS ที่ใครเปิดเว็บก็อ่านได้
  location /ai-proxy/ {
    proxy_pass ${AI_ORIGIN}/;
    proxy_http_version 1.1;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    # โมเดล 9B คิดนานกว่า API คลาวด์ — ดีฟอลต์ 60 วิของ nginx ตัดกลางคันได้
    proxy_read_timeout 120s;
    proxy_send_timeout 120s;

    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Content-Security-Policy "${CSP}" always;
  }

  # ── ล็อกอินแทนผู้ใช้ที่ฝั่งเซิร์ฟเวอร์ (โหมด LAN ไม่ต้องมีหน้าล็อกอิน) ──
  #
  # 🔴 **รหัสผ่านไม่เคยออกจากเครื่องนี้** — nginx เป็นคนใส่ให้ตอน proxy ไป Supabase
  # หน้าเว็บได้กลับไปแค่ access_token (อายุ 60 นาที) ซึ่งเดิมก็ได้อยู่แล้วตอนผู้ใช้ล็อกอินเอง
  # ห้ามเอา FARM_USER/FARM_PASS ไปไว้ใน `VITE_*` เด็ดขาด — ค่าพวกนั้นถูกฝังลงไฟล์ JS
  #
  # ⚠️ ใครก็ตามที่เข้าถึงเว็บนี้ได้ = ขอ token ได้ = สั่งอุปกรณ์ได้
  # ปลอดภัยเพราะเว็บอยู่ในวง LAN บริษัทเท่านั้น (เจ้าของงานยืนยัน 2026-08-11)
  # **ถ้าวันหลังเปิดออกอินเทอร์เน็ต ต้องปิด endpoint นี้ก่อน** ไม่งั้นเท่ากับแจกกุญแจโรงเรือน
  #
  # ไม่ได้ตั้ง `FARM_USER` = คืน 404 → หน้าเว็บจะถอยไปใช้หน้าล็อกอินตามปกติเอง
  location = /auth/token {
    access_log off;
    if ($farm_user = "") { return 404; }

    proxy_method POST;
    proxy_pass ${SUPABASE_ORIGIN}/auth/v1/token?grant_type=password;
    proxy_http_version 1.1;
    proxy_ssl_server_name on;
    proxy_set_header Content-Type "application/json";
    proxy_set_header apikey "${SUPABASE_ANON_KEY}";
    proxy_set_header Authorization "";
    proxy_set_body '{"email":"${FARM_USER}","password":"${FARM_PASS}"}';

    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Content-Security-Policy "${CSP}" always;
  }

  # ── health endpoint สำหรับ Docker/orchestrator healthcheck — เบา ไม่ลง access log ──
  location = /healthz {
    access_log off;
    add_header Content-Type text/plain;
    return 200 "ok\n";

    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Content-Security-Policy "${CSP}" always;
  }

  # ── static assets (JS/CSS hashed + รูปฉาก) — cache นานหน่อย ──
  location /assets/ {
    expires 7d;
    add_header Cache-Control "public";
    try_files $uri =404;

    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Content-Security-Policy "${CSP}" always;
  }

  # index.html ห้าม cache — จะได้เห็น build ใหม่ทันทีหลัง deploy
  # (SPA fallback ของ location / วิ่งเข้าบล็อกนี้ผ่าน internal redirect → คือหน้าที่คนเปิดจริงทุกครั้ง)
  location = /index.html {
    add_header Cache-Control "no-cache";

    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Content-Security-Policy "${CSP}" always;
  }

  # ── SPA fallback — เส้นทางฝั่ง client (react-router) ให้ตกมาที่ index.html ──
  location / {
    try_files $uri $uri/ /index.html;

    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Content-Security-Policy "${CSP}" always;
  }
}
