# Syntech Smart Farm — nginx (prod)
# envsubst แทน ${BACKEND_ORIGIN} ตอน container start (ตัวแปร nginx เช่น $uri/$host ไม่ถูกแตะ)

server {
  listen 80;
  server_name _;
  root /usr/share/nginx/html;
  index index.html;

  # บีบอัดไฟล์ข้อความ
  gzip on;
  gzip_comp_level 6;
  gzip_min_length 1024;
  gzip_types text/plain text/css application/javascript application/json image/svg+xml;

  # ── reverse-proxy คำสั่งจริง → backend (same-origin เลี่ยง CORS) ──
  # /hs-proxy/api/v1/... → ${BACKEND_ORIGIN}/api/v1/... (trailing slash ตัด prefix ออก)
  # apiBaseUrl() ฝั่งเว็บคืน `/hs-proxy/api/v1` · WebSocket ต่อ backend ตรง ไม่ผ่านที่นี่
  location /hs-proxy/ {
    proxy_pass ${BACKEND_ORIGIN}/;
    proxy_http_version 1.1;
    proxy_ssl_server_name on;          # SNI สำหรับ backend HTTPS
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    # ส่ง Authorization/Content-Type ต่อให้ upstream อัตโนมัติ (ไม่ล้าง) · ไม่ cache ผล
  }

  # ── health endpoint สำหรับ Docker/orchestrator healthcheck — เบา ไม่ลง access log ──
  location = /healthz {
    access_log off;
    add_header Content-Type text/plain;
    return 200 "ok\n";
  }

  # ── static assets (JS/CSS hashed + รูปฉาก) — cache นานหน่อย ──
  location /assets/ {
    expires 7d;
    add_header Cache-Control "public";
    try_files $uri =404;
  }

  # index.html ห้าม cache — จะได้เห็น build ใหม่ทันทีหลัง deploy
  location = /index.html {
    add_header Cache-Control "no-cache";
  }

  # ── SPA fallback — เส้นทางฝั่ง client (react-router) ให้ตกมาที่ index.html ──
  location / {
    try_files $uri $uri/ /index.html;
  }

  # security headers เบาๆ
  add_header X-Content-Type-Options "nosniff" always;
  add_header X-Frame-Options "SAMEORIGIN" always;
  add_header Referrer-Policy "strict-origin-when-cross-origin" always;
}
