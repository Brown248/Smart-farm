{
  "name": "syntech-smart-farm",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "packages/shared",
    "packages/web"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "npm run dev -w @syntech/web",
    "build": "npm run build -w @syntech/web",
    "preview": "npm run preview -w @syntech/web",
    "typecheck": "tsc --noEmit -p packages/shared && tsc --noEmit -p packages/web",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"packages/**/*.{ts,tsx,css,json,md}\" \"docs/**/*.md\"",
    "format:check": "prettier --check \"packages/**/*.{ts,tsx,css,json,md}\" \"docs/**/*.md\"",
    "test": "vitest run -r packages/web",
    "test:watch": "vitest -r packages/web",
    "verify": "npm run typecheck && npm run lint && npm run test",
    "token": "node scripts/get-token.cjs",
    "smoke:switch": "node scripts/smoke-setswitch.cjs",
    "smoke:threshold": "node scripts/smoke-threshold.cjs",
    "smoke:schedule": "node scripts/smoke-schedule.cjs",
    "smoke:read": "node scripts/smoke-read.cjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "eslint": "^9.17.0",
    "eslint-plugin-react": "^7.37.2",
    "eslint-plugin-react-hooks": "^5.1.0",
    "globals": "^15.14.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1"
  }
}
